import *.caddy

###############################################################################
#                          ГЛОБАЛЬНЫЕ НАСТРОЙКИ                               #
###############################################################################
{
	debug
	order crowdsec before respond

	auto_https off

	# Traefik terminates TLS and proxies here; without trusted_proxies,
	# crowdsec/appsec attributes Traefik's Docker IP (172.18.0.6) instead of ClientHost.
	servers {
		trusted_proxies static 172.18.0.0/24 172.19.0.0/24
	}

	# snippets
	import crowdsec_config
	import logs_global
}

:{$PORT_LOCAL_CADDYWEB} {
	encode gzip zstd

	route {
		crowdsec
		appsec

		# Decoy templates ship http:// CDN links; upgrade them on HTTPS pages.
		header Content-Security-Policy "upgrade-insecure-requests"

		root * /srv
		# SPA-фоллбек: если файла нет — отдать /index.html с 200
		try_files {path} /index.html
		file_server
	}
}
