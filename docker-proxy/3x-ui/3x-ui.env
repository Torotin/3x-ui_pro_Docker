TZ=Europe/Moscow
XRAY_VMESS_AEAD_FORCED=false

USERNAME=admin
PASSWORD=admin
NEW_ADMIN_USERNAME="${USER_WEB:-admin}"
NEW_ADMIN_PASSWORD="${PASS_WEB:-admin}"
XUI_API_TOKEN=
# AfterStart runtime: python (default) | bash (emergency rollback only).
XUI_RUNTIME_ENGINE=python

XRAY_MANAGED_WARP="true"
XRAY_MANAGED_WARP_CONSOLE="true"
ENABLE_VLESS_GRPC="${ENABLE_VLESS_GRPC:-false}"
# XHTTP runtime knobs (defaults in xui_runtime/env.py init_defaults):
# XHTTP_MODE="packet-up"
# XHTTP_SC_MAX_BUFFERED_POSTS="50"
# XHTTP_SC_MAX_EACH_POST_BYTES="5000000"
# XHTTP_SC_STREAM_UP_SERVER_SECS="5-20"
# XHTTP_X_PADDING_BYTES="100-1000"
# XHTTP_NO_SSE_HEADER="true"
# XHTTP_SET_HOST="true"
# XHTTP_HEADERS_UA=""
# XHTTP_CLIENT_EXTRA_ENABLE="false"
# XHTTP_XMUX_MAX_CONCURRENCY="16-32"
# XHTTP_XMUX_H_MAX_REQUEST_TIMES="600-900"
# XHTTP_XMUX_H_MAX_REUSABLE_SECS="1800-3000"
# VLESS_GRPC_WHEN_DISABLED="disable"
# AmneziaWG runtime knobs (defaults in xui_runtime/env.py init_defaults):
# AWG_MTU="1280"
# AWG_MTU_OVERHEAD="96"
# AWG_HOST_MTU=""
# AWG_S1="16"
# AWG_S2="16"
# AWG_S3="16"
# AWG_S4="16"
# AWG_H1="1"
# AWG_H2="2"
# AWG_H3="3"
# AWG_H4="4"
# AWG_JC="4"
# AWG_JMIN="50"
# AWG_JMAX="120"
# AWG_CONTENT_PADDING="0-16"
# AWG_KEEPALIVE_TIMEOUT="9-17"
# AWG_REKEY_AFTER_TIME=""
# AWG_REKEY_TIMEOUT=""
# AWG_REJECT_AFTER_TIME=""
# AWG_MAX_HANDSHAKE_ATTEMPTS=""
# AWG_RANDOM_TRAILERS="true"
# AWG_DISABLE_COOKIES="false"
# AWG_I1="<r 55>"
# AWG_I2=""
# AWG_I3=""
# AWG_I4=""
# AWG_I5=""
# AWG_DNS1="8.8.8.8"
# AWG_DNS2="8.8.4.4"
# AWG_CLIENT_KEEPALIVE="25"
UDP443_BACKEND="${UDP443_BACKEND:-amneziawg}"
ENABLE_HYSTERIA2="${ENABLE_HYSTERIA2:-false}"
ENABLE_AMNEZIAWG="${ENABLE_AMNEZIAWG:-true}"
DOWNLOAD_GEO_DIRECT="${DOWNLOAD_GEO_DIRECT:-true}"
# Cert/key/masq come from compose.d/.env (rendered by install env). Do not use
# bash ${VAR:-} here — Docker env_file does not expand shell parameter syntax.
# XRAY_TLS_CERT_FILE / XRAY_TLS_KEY_FILE / HYSTERIA2_MASQ_URL are set there.

webListen="0.0.0.0"
webDomain=""
webPort="${PORT_LOCAL_VLESS_PANEL}"
webCertFile=
webKeyFile=
webBasePath="/${URI_PANEL_PATH}/"
sessionMaxAge=60
pageSize=50
expireDiff=0
trafficDiff=0
remarkModel="-io"
datepicker="gregorian"
tgBotEnable="false"
tgBotToken=
tgBotProxy=
tgBotAPIServer=
tgBotChatId=
tgRunTime=
tgBotBackup="true"
tgBotLoginNotify="true"
tgCpu=85
tgLang="ru-RU"
twoFactorEnable=
twoFactorToken=
xrayTemplateConfig=
subEnable="true"
subJsonEnable="true"
subTitle="${WEBDOMAIN}"
subSupportUrl=
subProfileUrl=
subAnnounce=
subEnableRouting="false"
subRoutingRules=
subListen="0.0.0.0"
subPort="${PORT_LOCAL_VLESS_SUBSCRIBE}"
subPath="${URI_SUB_PATH}"
subJsonPath="${URI_JSON_PATH}"
subDomain="${WEBDOMAIN}"
externalTrafficInformEnable="false"
externalTrafficInformURI=
subCertFile=
subKeyFile=
subUpdates=1
subEncrypt="true"
subShowInfo="true"
subURI="https://${WEBDOMAIN}${URI_SUB_PATH}"
subJsonURI="https://${WEBDOMAIN}${URI_JSON_PATH}"
subClashEnable="true"
subClashPath="${URI_CLASH_PATH:-/clash/}"
subClashURI="https://${WEBDOMAIN}${URI_CLASH_PATH}"
subClashEnableRouting="true"
# subClashRules is computed at runtime to avoid storing multiline YAML here.
subJsonFragment=
subJsonNoises=
subJsonMux=
subJsonRules=
# subJsonRoutingRules / subJsonDns computed at runtime (Happ profile + dns hosts).
ldapEnable="false"
ldapHost=
ldapPort=389
ldapUseTLS="false"
ldapBindDN=
ldapPassword=
ldapBaseDN=
ldapUserFilter=
ldapUserAttr=
ldapVlessField=
ldapSyncCron=
ldapFlagField=
ldapTruthyValues=
ldapInvertFlag="false"
ldapInboundTags=
ldapAutoCreate="false"
ldapAutoDelete="false"
ldapDefaultTotalGB=0
ldapDefaultExpiryDays=0
ldapDefaultLimitIP=0
timeLocation="Europe/Moscow"
