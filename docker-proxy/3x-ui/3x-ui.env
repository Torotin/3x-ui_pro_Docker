TZ=Europe/Moscow
XRAY_VMESS_AEAD_FORCED=false

USERNAME=admin
PASSWORD=admin
NEW_ADMIN_USERNAME="${USER_WEB:-admin}"
NEW_ADMIN_PASSWORD="${PASS_WEB:-admin}"
XUI_API_TOKEN=
# AfterStart runtime: python (default) | bash (emergency rollback only).
XUI_RUNTIME_ENGINE=python

XRAY_MANAGED_WARP_CONSOLE="false"
ENABLE_VLESS_GRPC="${ENABLE_VLESS_GRPC:-false}"
UDP443_BACKEND="${UDP443_BACKEND:-amneziawg}"
ENABLE_HYSTERIA2="${ENABLE_HYSTERIA2:-false}"
ENABLE_AMNEZIAWG="${ENABLE_AMNEZIAWG:-true}"
DOWNLOAD_GEO_DIRECT="${DOWNLOAD_GEO_DIRECT:-true}"
# Cert/key/masq come from compose.d/.env (rendered by install env). Do not use
# bash ${VAR:-} here — Docker env_file does not expand shell parameter syntax.
# XRAY_TLS_CERT_FILE / XRAY_TLS_KEY_FILE / HYSTERIA2_MASQ_URL are set there.

webListen="0.0.0.0"
webDomain=""
webPort="${PORT_LOCAL_VLESS_PANEL}"
webCertFile=
webKeyFile=
webBasePath="/${URI_PANEL_PATH}/"
sessionMaxAge=60
pageSize=50
expireDiff=0
trafficDiff=0
remarkModel="-io"
datepicker="gregorian"
tgBotEnable="false"
tgBotToken=
tgBotProxy=
tgBotAPIServer=
tgBotChatId=
tgRunTime=
tgBotBackup="true"
tgBotLoginNotify="true"
tgCpu=85
tgLang="ru-RU"
twoFactorEnable=
twoFactorToken=
xrayTemplateConfig=
subEnable="true"
subJsonEnable="true"
subTitle="${WEBDOMAIN}"
subSupportUrl=
subProfileUrl=
subAnnounce=
subEnableRouting="false"
subRoutingRules=
subListen="0.0.0.0"
subPort="${PORT_LOCAL_VLESS_SUBSCRIBE}"
subPath="${URI_SUB_PATH}"
subJsonPath="${URI_JSON_PATH}"
subDomain="${WEBDOMAIN}"
externalTrafficInformEnable="false"
externalTrafficInformURI=
subCertFile=
subKeyFile=
subUpdates=1
subEncrypt="true"
subShowInfo="true"
subURI="https://${WEBDOMAIN}${URI_SUB_PATH}"
subJsonURI="https://${WEBDOMAIN}${URI_JSON_PATH}"
subClashEnable="true"
subClashPath="${URI_CLASH_PATH:-/clash/}"
subClashURI="https://${WEBDOMAIN}${URI_CLASH_PATH}"
subClashEnableRouting="true"
# subClashRules is computed at runtime to avoid storing multiline YAML here.
subJsonFragment=
subJsonNoises=
subJsonMux=
subJsonRules=
# subJsonRoutingRules / subJsonDns computed at runtime (Happ profile + dns hosts).
ldapEnable="false"
ldapHost=
ldapPort=389
ldapUseTLS="false"
ldapBindDN=
ldapPassword=
ldapBaseDN=
ldapUserFilter=
ldapUserAttr=
ldapVlessField=
ldapSyncCron=
ldapFlagField=
ldapTruthyValues=
ldapInvertFlag="false"
ldapInboundTags=
ldapAutoCreate="false"
ldapAutoDelete="false"
ldapDefaultTotalGB=0
ldapDefaultExpiryDays=0
ldapDefaultLimitIP=0
timeLocation="Europe/Moscow"
