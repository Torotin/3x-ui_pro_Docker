###############################################
#     СЕТЕВЫЕ НАСТРОЙКИ + TCP BBR + ЗАЩИТА    #
#     NETWORK SETTINGS + TCP BBR + SECURITY    #
#         Xray Optimized sysctl Config         #
###############################################

#############################
# 1. Ядро сети и производительность
# 1. Network Core & Performance
#############################

# Планировщик пакетов Fair Queue (необходим для работы BBR)
net.core.default_qdisc = fq

# Алгоритм управления перегрузками TCP BBR (высокая пропускная способность и низкая задержка)
net.ipv4.tcp_congestion_control = bbr

# Разрешить маршрутизацию IPv4-пакетов между интерфейсами (необходимо для Docker и прокси)
net.ipv4.ip_forward = 1

# Размеры сокетных буферов: 256 КБ по умолчанию, до 128 МБ максимум (для QUIC / Hysteria2 / WireGuard)
net.core.rmem_default = 262144
net.core.rmem_max     = 134217728
net.core.wmem_default = 262144
net.core.wmem_max     = 134217728

# Максимальная очередь входящих подключений на сокете (listen backlog)
net.core.somaxconn           = 30000
# Максимальная длина очереди пакетов на сетевом интерфейсе до обработки ядром
net.core.netdev_max_backlog  = 250000
# Количество пакетов и время (мкс) обработки за один цикл NAPI poll
net.core.netdev_budget       = 600
net.core.netdev_budget_usecs = 8000

# Максимальное число экземпляров inotify на пользователя (для сервисов, отслеживающих файлы)
fs.inotify.max_user_instances = 30000
# Общий системный лимит открытых файловых дескрипторов и сокетов
fs.file-max                   = 1048576

#############################
# 2. UDP буферы / UDP Buffers
#############################

# Минимальный гарантированный размер буфера приёма/отправки на один UDP-сокет (общий udp_mem рассчитывает ядро)
net.ipv4.udp_rmem_min = 8192
net.ipv4.udp_wmem_min = 8192

#############################
# 3. TCP ускорение и оптимизация / TCP Acceleration & Optimization
#############################

# Защита от устаревших пакетов в состоянии TIME_WAIT (RFC 1337)
net.ipv4.tcp_rfc1337             = 1
# Максимальная очередь полуоткрытых TCP-соединений (SYN backlog)
net.ipv4.tcp_max_syn_backlog     = 30000
# Время удержания сокета в состоянии FIN-WAIT-2 перед закрытием (сек)
net.ipv4.tcp_fin_timeout         = 15
# Число повторных отправок SYN при установке исходящего соединения (~15 сек при значении 3)
net.ipv4.tcp_syn_retries         = 3
# Число повторных отправок SYN-ACK при входящем подключении
net.ipv4.tcp_synack_retries      = 2
# Время бездействия до отправки первой TCP keepalive-проверки (сек)
net.ipv4.tcp_keepalive_time      = 600
# Количество неудачных keepalive-проверок до разрыва соединения
net.ipv4.tcp_keepalive_probes    = 5
# Интервал между TCP keepalive-проверками (сек)
net.ipv4.tcp_keepalive_intvl     = 30
# Активный Path MTU discovery с первого SYN (2); надёжнее режима 1 на облачных MTU 1450–1480 без ICMP)
net.ipv4.tcp_mtu_probing         = 2
# Включить TCP Fast Open для входящих (1) и исходящих (2) соединений (1 + 2 = 3)
net.ipv4.tcp_fastopen            = 3
# Не сбрасывать окно перегрузки TCP после простоя соединения (ускоряет возобновление трафика)
net.ipv4.tcp_slow_start_after_idle = 0
# Разрешить выборочные подтверждения TCP (Selective Acknowledgments) для быстрого восстановления потерь
net.ipv4.tcp_sack                = 1
# Использовать метки времени TCP (необходимы для точного расчёта RTT в BBR)
net.ipv4.tcp_timestamps          = 1
# Масштабирование окна TCP (позволяет использовать буферы больше 64 КБ)
net.ipv4.tcp_window_scaling      = 1
# Автоматическая подстройка размера буфера приёма TCP ядром
net.ipv4.tcp_moderate_rcvbuf     = 1
# Максимальное число сокетов в состоянии TIME_WAIT
net.ipv4.tcp_max_tw_buckets      = 262144
# Сохранять метрики маршрутов в кэше ядра для ускорения повторных соединений
net.ipv4.tcp_no_metrics_save     = 0
# Расширенный диапазон локальных эфемерных портов для исходящих соединений
net.ipv4.ip_local_port_range     = 10240 65535

# Буферы TCP (min / default / max — до 16 МБ на сокет, чтобы не исчерпать RAM на малых VPS)
net.ipv4.tcp_rmem                = 4096 87380 16777216
net.ipv4.tcp_wmem                = 4096 65536 16777216

#############################
# 4. Conntrack (для NAT, Docker и TProxy)
#############################

# Максимальное количество отслеживаемых соединений в таблице conntrack
net.netfilter.nf_conntrack_max                      = 262144
# Время жизни установленного TCP-соединения в таблице conntrack (сек)
net.netfilter.nf_conntrack_tcp_timeout_established  = 3600
# Таймаут записи conntrack для состояний TIME_WAIT, CLOSE_WAIT и FIN_WAIT (сек)
net.netfilter.nf_conntrack_tcp_timeout_time_wait    = 120
net.netfilter.nf_conntrack_tcp_timeout_close_wait   = 60
net.netfilter.nf_conntrack_tcp_timeout_fin_wait     = 60

#############################
# 5. Защита и фильтрация IPv4 / Security & Filtering
#############################

# Защита от SYN-флуда при переполнении очереди подключений
net.ipv4.tcp_syncookies              = 1
# Разрешить ответы на обычные ICMP echo-запросы (ping) для диагностики
net.ipv4.icmp_echo_ignore_all        = 0
# Игнорировать широковещательные ICMP-запросы (защита от Smurf-атак)
net.ipv4.icmp_echo_ignore_broadcasts = 1
# Минимальный интервал между однотипными ICMP-ответами в мс (1000 мс = 1 пакет/сек)
net.ipv4.icmp_ratelimit              = 1000

# Loose rp_filter (2): проверка обратного маршрута без блокировки Docker bridge, policy routing и WARP
net.ipv4.conf.all.rp_filter          = 2
net.ipv4.conf.default.rp_filter      = 2

# Запрет маршрутизации от источника (защита от спуфинга маршрутов)
net.ipv4.conf.all.accept_source_route     = 0
net.ipv4.conf.default.accept_source_route = 0
# Запрет приёма любых ICMP Redirect (защита от подмены таблицы маршрутизации)
net.ipv4.conf.all.accept_redirects        = 0
net.ipv4.conf.default.accept_redirects    = 0
net.ipv4.conf.all.secure_redirects        = 0
net.ipv4.conf.default.secure_redirects    = 0
# Запрет отправки ICMP Redirect (чтобы хост не раскрывал внутреннюю маршрутизацию Docker)
net.ipv4.conf.all.send_redirects          = 0
net.ipv4.conf.default.send_redirects      = 0

#############################
# 6. ARP фильтрация / ARP Filtering
#############################

# Оставить стандартное поведение ARP (0) для корректной работы виртуальных мостов Docker
net.ipv4.conf.all.arp_filter     = 0
net.ipv4.conf.default.arp_filter = 0

#############################
# 7. IPv6 маршрутизация и защита / IPv6 Routing & Hardening
#############################

# Полное отключение IPv6 на хосте (1) при HOST_IP_MODE=ipv4 — без AAAA-таймаутов в apt/curl/dockerd
net.ipv6.conf.all.disable_ipv6     = __IPV6_DISABLE__
net.ipv6.conf.default.disable_ipv6 = __IPV6_DISABLE__
# Пересылка IPv6-пакетов (0 — выключена, 1 — включена)
net.ipv6.conf.all.forwarding     = __IPV6_FORWARDING__
net.ipv6.conf.default.forwarding = __IPV6_FORWARDING__
# Автоконфигурация IPv6-адресов SLAAC (0 — выключена, 1 — включена)
net.ipv6.conf.all.autoconf       = __IPV6_AUTOCONF__
net.ipv6.conf.default.autoconf   = __IPV6_AUTOCONF__
# Приём Router Advertisements (0 — выключен, 1 — при выкл. forwarding, 2 — при вкл. forwarding)
net.ipv6.conf.all.accept_ra      = __IPV6_ACCEPT_RA__
net.ipv6.conf.default.accept_ra  = __IPV6_ACCEPT_RA__

# Запрет маршрутизации от источника и приёма ICMPv6 Redirect
net.ipv6.conf.all.accept_source_route     = 0
net.ipv6.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_redirects        = 0
net.ipv6.conf.default.accept_redirects    = 0
# Ограничение частоты ICMPv6-ответов (1000 мс)
net.ipv6.icmp.ratelimit                   = 1000
