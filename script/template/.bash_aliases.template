############################################################
#                  NAVIGATION                              #
############################################################
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias cls='clear'
alias mkdir='mkdir -pv'

############################################################
#                  FILE LISTING                            #
############################################################
alias lf='ls -CF'
alias lfa='ls -A'
alias ll='ls -alF'
alias lfs='ls -lSh'            # largest first
alias lfsr='ls -lhSr'          # smallest first (reverse size)
alias lft='ls -lt'             # newest first
alias lftr='ls -ltr'           # oldest first

############################################################
#                  QUICK CD                                #
############################################################
alias hd='cd ~'
alias cdopt='cd /opt'
alias cdetc='cd /etc'
alias cdvar='cd /var'
alias cdlogs='cd /var/log'
alias cdroot='cd /root'
alias cdproxy='cd /opt/docker-proxy'

############################################################
#                  ARCHIVES                                #
############################################################
alias untar='tar -xvf'

############################################################
#                  SYSTEM                                  #
############################################################
alias reboot='sudo reboot now'
alias shutdown='sudo shutdown now'
alias show-ports='ss -tuln'
alias cpu-info='lscpu'
alias mem-info='free -h'
alias disk-usage='df -h'
alias sys-journal='journalctl -xe'

# systemctl shortcuts
alias sc-restart='sudo systemctl restart'
alias sc-status='sudo systemctl status'
alias sc-enable='sudo systemctl enable'
alias sc-disable='sudo systemctl disable'

############################################################
#                  PROJECT (3x-ui / docker-proxy)          #
############################################################
alias install-wizard='sudo /opt/docker-proxy/script/install.sh wizard'
alias install-doctor='sudo /opt/docker-proxy/script/install.sh doctor'

############################################################
#                  DOCKER                                  #
############################################################
alias docker-ps='docker ps'
alias docker-ps-all='docker ps -a'
alias docker-start='docker start'
alias docker-stop='docker stop'
alias docker-rm='docker rm'
alias docker-images='docker images'
alias docker-exec='docker exec -it'
alias docker-build='docker build'
alias docker-logs='docker logs'
alias docker-prune='docker system prune -f'

# Docker Compose shortcuts (run from compose project dir, e.g. cdproxy)
alias dc-up='docker compose up -d'
alias dc-down='docker compose down'
alias dc-logs='docker compose logs -f'
alias dc-build='docker compose build'
alias dc-ps='docker compose ps'
alias dc-restart='docker compose restart'
# dc-pull is a function (see bottom) so service args apply to both pull and up.

############################################################
#                  APT                                     #
############################################################
alias apt-update='sudo apt update'
alias apt-upgrade='sudo apt upgrade -y'
alias apt-full-upgrade='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
alias apt-install='sudo apt install -y'
alias apt-remove='sudo apt remove -y'
alias apt-autoremove='sudo apt autoremove -y'
alias apt-search='apt search'
alias apt-clean='sudo apt clean && sudo apt autoclean'

############################################################
#                  SEARCH & UTILS                          #
############################################################
alias grep='grep --color=auto'
alias find-links='find . -type l -ls'
alias find-file='find . -name'
alias whichall='type -a'
alias datetime='date "+%Y-%m-%d %H:%M:%S"'

############################################################
#                  NETWORK                                 #
############################################################
alias public-ip='curl -fsS --max-time 3 https://ifconfig.me; echo'
alias ping-google='ping -c 4 8.8.8.8'
alias netstat-all='netstat -tulpen'
alias trace-route='traceroute'
alias dns-status='resolvectl status'

# Listening ports with PID/process (sudo)
alias ss-ports='echo "Netid State  Recv-Q Send-Q   Local_Address:Port     Peer:Port    Process,PID,FD"; \
sudo ss -tulpn | tail -n +2 | sort -t: -k2,2n | sed -E "s/users:\(\((.*)\)\)/\1/" | sed -E "s/[\"()]//g"'

############################################################
#                  MISC                                    #
############################################################
alias reload-bashrc='source ~/.bashrc'
alias show-path='echo $PATH'
alias list-aliases='cat ~/.bash_aliases'

############################################################
#                  FUNCTIONS                               #
############################################################
# Pass service names through to both sides: dc-pull 3x-ui
dc-pull() { docker compose pull "$@" && docker compose up -d "$@"; }
